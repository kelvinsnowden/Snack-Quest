rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Staff Users Collection
    match /staff_users/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Roles Collection
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Role Permissions Collection
    match /role_permissions/{permissionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Audit Logs Collection (Immutable)
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Webhook Events Collection
    match /webhook_events/{eventId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Test Connection Document
    match /test/connection {
      allow read: if true;
    }
  }
}
