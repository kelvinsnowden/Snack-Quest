rules_version = '2';

// Full ruleset from TECHNICAL_DESIGN_DOCUMENT.md §9. Deny by default,
// grant explicitly — every rule below is additive to an implicit
// `allow read, write: if false;` base.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function hasRole(role) {
      return isSignedIn() && role in request.auth.token.roles;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isNotDeleted() {
      return resource.data.deletedAt == null;
    }
    function belongsToBusiness(businessId) {
      return isSignedIn() && businessId == request.auth.token.businessId;
    }
    // A staff member is only ever an admin for *their own* tenant — see
    // `services/staffAuthService.ts`'s `establishSession()`, which sets
    // the `businessId` custom claim on every staff login. Every
    // `isAdmin()` call below that gates a business-owned collection
    // pairs it with `belongsToBusiness(resource.data.businessId)` (or
    // `request.resource.data.businessId` on create), so an admin from
    // one tenant can never read or write another tenant's data through
    // the client SDK. This closes what used to be Open Question 6 in
    // PLATFORM_ARCHITECTURE_V2.md §21 — the claim this was gated on is
    // now issued, so the gap is live, not deferred. Collections with no
    // `businessId` field at all (`users` — the shared identity root
    // every role sits on top of; `webhookInspections` — a temporary
    // diagnostic collection already marked for deletion) keep the
    // platform-wide `isAdmin()` check unchanged, since there is no
    // tenant field to scope them by.
    function isAdmin() {
      return hasRole('admin') || hasRole('super_admin');
    }
    function isTenantAdmin(businessId) {
      return isAdmin() && belongsToBusiness(businessId);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // A self-registering customer may only ever grant themselves the
      // 'customer' role — staff/creator roles are never client-writable,
      // since `roles` here is the exact array copied onto the Auth custom
      // claim that Security Rules and route guards trust everywhere else
      // (§ Admin auth foundation). Anyone provisioning a staff or creator
      // account does so with the Admin SDK, which bypasses these rules
      // entirely, so this restriction only closes the client-write path.
      allow create: if isOwner(uid) &&
                       request.resource.data.roles == ['customer'];
      allow update: if isAdmin() ||
                       (isOwner(uid) &&
                        !request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasAny(['roles']));
      allow delete: if false; // soft delete only, via server
    }

    match /customerProfiles/{uid} {
      allow read: if isOwner(uid) || isTenantAdmin(resource.data.businessId);
      allow update: if (isOwner(uid) &&
                          !request.resource.data.diff(resource.data)
                            .affectedKeys()
                            .hasAny(['walletBalanceKes','lifetimeCreditsEarnedKes'])) || isTenantAdmin(resource.data.businessId);
      allow create, delete: if false;
    }

    match /staffProfiles/{uid} {
      allow read: if isOwner(uid) || isTenantAdmin(resource.data.businessId);
      // only super admins manage staff, and only their own tenant's —
      // `resource.data` doesn't exist yet on create, so that half of
      // the check only applies to update/delete.
      allow create: if hasRole('super_admin') && belongsToBusiness(request.resource.data.businessId);
      allow update: if hasRole('super_admin') &&
                       belongsToBusiness(resource.data.businessId) &&
                       belongsToBusiness(request.resource.data.businessId);
      allow delete: if hasRole('super_admin') && belongsToBusiness(resource.data.businessId);
    }

    match /campaigns/{campaignId} {
      allow read: if (isSignedIn() && resource.data.status == 'active') || isTenantAdmin(resource.data.businessId);
      allow create: if isTenantAdmin(request.resource.data.businessId);
      allow update: if isTenantAdmin(resource.data.businessId) && isTenantAdmin(request.resource.data.businessId);
      allow delete: if isTenantAdmin(resource.data.businessId);
    }

    match /campaignSubmissions/{submissionId} {
      allow read: if isTenantAdmin(resource.data.businessId) ||
                     (hasRole('creator') && resource.data.creatorId == request.auth.uid);
      allow create: if hasRole('creator') &&
                       request.resource.data.creatorId == request.auth.uid &&
                       request.resource.data.status == 'pending'; // cannot self-approve
      allow update: if isTenantAdmin(resource.data.businessId); // status transitions are admin/server-only
      allow delete: if false;
    }

    match /withdrawals/{withdrawalId} {
      allow read: if isTenantAdmin(resource.data.businessId) ||
                     (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.status == 'pending';
      allow update: if isTenantAdmin(resource.data.businessId); // approve/reject/pay is admin/server-only
      allow delete: if false;
    }

    match /refunds/{refundId} {
      allow read: if isTenantAdmin(resource.data.businessId);
      allow write: if false; // Admin SDK only — RefundService is the only writer
    }

    // customerWallets: the Quest wallet balance + ledger (§ Phase 4:
    // Customer loyalty / Quest system) — keyed by phone number, not a
    // Firebase Auth uid, because almost every real customer has no
    // Auth account at all (see `types/customerWallet.ts`). No
    // client-side identity exists to grant self-access against, so
    // this stays admin-read/server-write-only, same discipline as
    // `earningsLedger` above, until a real Auth-based customer
    // identity exists to revisit this against.
    match /customerWallets/{walletId} {
      allow read: if isTenantAdmin(resource.data.businessId);
      allow write: if false; // WalletService (Admin SDK) only, always

      match /ledger/{entryId} {
        allow read: if isTenantAdmin(get(/databases/$(database)/documents/customerWallets/$(walletId)).data.businessId);
        allow write: if false;
      }
    }

    // orders: nested per the multi-delivery-method redesign
    // (product/customer/delivery/payment/pricing) — `customerId` now
    // lives at `customer.customerId`, not the document root.
    match /orders/{orderId} {
      allow read: if isTenantAdmin(resource.data.businessId) ||
                     (isSignedIn() && resource.data.customer.customerId == request.auth.uid);
      allow create: if false; // orders created via Route Handler (payment validation)
      allow update: if isTenantAdmin(resource.data.businessId);

      match /items/{itemId} {
        allow read: if isTenantAdmin(get(/databases/$(database)/documents/orders/$(orderId)).data.businessId) ||
                       (isSignedIn() &&
                        get(/databases/$(database)/documents/orders/$(orderId)).data.customer.customerId == request.auth.uid);
        allow write: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if isTenantAdmin(resource.data.businessId) ||
                     (isSignedIn() && resource.data.recipientId == request.auth.uid);
      allow update: if isSignedIn() &&
                       resource.data.recipientId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false; // server-written only
    }

    match /auditLogs/{logId} {
      allow read: if isTenantAdmin(resource.data.businessId);
      allow write: if false; // Cloud Function / Admin SDK only, immutable
    }

    // webhookEvents: the shared inbound idempotency ledger for every
    // provider webhook (Daraja, Whatchimp, Jumia) — PLATFORM_ARCHITECTURE_V2.md
    // §7/§13/§15. No client ever reads or writes this; it exists purely
    // for server-side handlers to check before processing a callback.
    match /webhookEvents/{eventId} {
      allow read, write: if false; // Admin SDK only, always
    }

    // outboundGatewayCalls: outbound idempotency for Gateway calls with
    // side effects (§13). Same server-only discipline as webhookEvents,
    // just for the opposite direction.
    match /outboundGatewayCalls/{callId} {
      allow read, write: if false; // Admin SDK only, always
    }

    // smsOptOuts: the marketing-SMS opt-out register (§ marketing SMS
    // opt-out). Server-only despite being written on a customer's
    // action: the customer has no Firebase Auth account to be
    // authenticated as (see types/smsOptOut.ts), so the write goes
    // through /api/sms/opt-out, which authorises it by verifying the
    // signed token from their own message. A client-writable rule would
    // have nothing better than the phone number to check, which is not
    // a secret.
    match /smsOptOuts/{optOutId} {
      allow read, write: if false; // Admin SDK only, always
    }

    // conversations: the transactional surface (§6). Most Snack Quest
    // customers never have a Firebase Auth account at all (WhatsApp is
    // the identity), so in practice almost every read of this
    // collection is server-side (Admin SDK, bypasses rules) — this
    // rule only matters for the minority of customers who ARE
    // identified AND later sign in (e.g. via a future Quest Center),
    // letting them see their own conversation history.
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && resource.data.customerId == request.auth.uid;
      allow write: if false; // ConversationService (Admin SDK) only, always

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
                       get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid;
        allow write: if false;
      }
    }

    // packages: public product catalog for the conversation's box
    // presentation step (§5) — same public-read/admin-write shape as
    // campaigns' active-only rule.
    match /packages/{packageId} {
      allow read: if resource.data.isActive == true || isTenantAdmin(resource.data.businessId);
      allow create: if isTenantAdmin(request.resource.data.businessId);
      allow update, delete: if isTenantAdmin(resource.data.businessId);
    }

    // faqs: public FAQ entries for the homepage FAQ section and /faq
    // page (§ Admin: FAQ) — same public-read/admin-write shape as packages.
    match /faqs/{faqId} {
      allow read: if resource.data.isActive == true || isTenantAdmin(resource.data.businessId);
      allow create: if isTenantAdmin(request.resource.data.businessId);
      allow update, delete: if isTenantAdmin(resource.data.businessId);
    }

    // reviews: customer reviews (§ homepage reviews). Writes are
    // unconditionally denied here even though the submission form is
    // public — it posts to `POST /api/reviews`, which validates the
    // text, size-caps and magic-byte-checks the photos, rate-limits by
    // phone number, and forces `status: 'pending'`. A direct client
    // write would bypass every one of those, so the only writer is the
    // Admin SDK behind that route.
    //
    // Reads mirror `faqs`: a published review is public (it is
    // rendered on the homepage), and everything else — pending
    // submissions awaiting moderation, rejected ones, and the
    // `contactPhone` a reviewer gave for follow-up — is admin-only.
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'published' || isTenantAdmin(resource.data.businessId);
      allow write: if false;
    }

    // inventoryMovements: the stock-adjustment audit trail (§ Admin:
    // Inventory) — staff-readable, Admin SDK-only writes (InventoryService
    // is the sole writer, always inside the same transaction as the
    // packages.stockCount update it records).
    match /inventoryMovements/{movementId} {
      allow read: if isTenantAdmin(resource.data.businessId);
      allow write: if false;
    }

    // suppliers, purchaseOrders, inventoryBatches (§ Inventory: batches,
    // purchase orders, suppliers, movements, low-stock alerts, expiry,
    // audit trail) — same admin-read/Admin-SDK-only-write discipline as
    // inventoryMovements above; SupplierService/PurchaseOrderService/
    // InventoryService are the sole writers.
    match /suppliers/{supplierId} {
      allow read: if isTenantAdmin(resource.data.businessId);
      allow write: if false;
    }
    match /purchaseOrders/{purchaseOrderId} {
      allow read: if isTenantAdmin(resource.data.businessId);
      allow write: if false;
    }
    match /inventoryBatches/{batchId} {
      allow read: if isTenantAdmin(resource.data.businessId);
      allow write: if false;
    }
    // fulfillmentBatches: one real shopping trip covering several orders
    // at once (§ Fulfillment Batches) — same admin-read/Admin-SDK-only
    // write shape as purchaseOrders/inventoryBatches.
    match /fulfillmentBatches/{batchId} {
      allow read: if isTenantAdmin(resource.data.businessId);
      allow write: if false;
    }

    // webhookInspections: TEMPORARY diagnostic capture of one real
    // WhatChimp inbound webhook, so parseIncomingMessage can be written
    // from fact rather than guessed. Delete this block along with
    // app/api/webhooks/whatchimp/inspect. Admin-read/Admin-SDK-only
    // write, same shape as every other server-owned collection. Stays
    // platform-wide `isAdmin()`, not `isTenantAdmin()` — this
    // diagnostic doc has no `businessId` field at all (see
    // `repositories/webhookInspectionRepository.ts`), and it's already
    // marked for deletion rather than worth retrofitting.
    match /webhookInspections/{inspectionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // marketingSpendEntries: manually-entered monthly ad spend, the
    // input § Admin: Analytics computes CAC from — admin-only, same
    // Admin-SDK-only-write discipline as everything else here.
    match /marketingSpendEntries/{entryId} {
      allow read: if isTenantAdmin(resource.data.businessId);
      allow write: if false;
    }

    // conversationCheckoutSnapshots: server-only, same reasoning as
    // conversations — the frozen pre-payment snapshot has no client
    // reader in the WhatsApp-first flow.
    match /conversationCheckoutSnapshots/{snapshotId} {
      allow read: if isTenantAdmin(resource.data.businessId);
      allow write: if false;
    }

    // paymentIntents: a signed-in customer may read their own intent's
    // status; every transition is server-verified (§7).
    match /paymentIntents/{intentId} {
      allow read: if isTenantAdmin(resource.data.businessId) ||
                     (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow write: if false;

      match /attempts/{attemptId} {
        allow read: if isTenantAdmin(get(/databases/$(database)/documents/paymentIntents/$(intentId)).data.businessId) ||
                       (isSignedIn() &&
                        get(/databases/$(database)/documents/paymentIntents/$(intentId)).data.customerId == request.auth.uid);
        allow write: if false;
      }
    }

    // domainEvents: internal event log (§14) — admin-visible for
    // debugging, never client-written.
    match /domainEvents/{eventId} {
      allow read: if isTenantAdmin(resource.data.businessId);
      allow write: if false;
    }

    // scheduledJobRuns: Vercel Cron run history (§ Phase 5:
    // Observability) — same admin-visible/server-write-only discipline
    // as domainEvents above.
    match /scheduledJobRuns/{runId} {
      allow read: if isTenantAdmin(resource.data.businessId);
      allow write: if false;
    }

    // shipments: fulfillment record, distinct from orders.status (§12).
    // Admin-only for now — no customer-facing web read of shipment
    // status exists yet (tracking updates go out over WhatsApp).
    match /shipments/{shipmentId} {
      allow read: if isTenantAdmin(resource.data.businessId);
      allow write: if false; // DeliveryService (Admin SDK) only
    }

    // referralLinks: a creator's own referral code (§8) — the owning
    // creator can see their own link, never anyone else's.
    match /referralLinks/{linkId} {
      allow read: if isTenantAdmin(resource.data.businessId) ||
                     (isSignedIn() && resource.data.ownerId == request.auth.uid);
      // creator onboarding creates these server-side
      allow create: if isTenantAdmin(request.resource.data.businessId);
      allow update, delete: if isTenantAdmin(resource.data.businessId);
    }

    // referralAttributions: the ledger proving why a commission was
    // paid (§8) — server-written only, same discipline as customerWallets' ledger.
    match /referralAttributions/{attributionId} {
      allow read: if isTenantAdmin(resource.data.businessId) ||
                     (isSignedIn() && resource.data.creatorId == request.auth.uid);
      allow write: if false;
    }

    // pickupStations: Jumia's pickup-station catalog, imported wholesale
    // from the authoritative dataset (§ Jumia pickup station integration).
    // Same public-read/admin-write shape as packages — a customer's
    // station search reads through the server (ConversationService,
    // Admin SDK), but nothing here is sensitive, so the pattern still
    // holds for any future direct client read.
    match /pickupStations/{stationId} {
      allow read: if resource.data.isActive == true || isTenantAdmin(resource.data.businessId);
      // seed script / Admin SDK only in practice
      allow create: if isTenantAdmin(request.resource.data.businessId);
      allow update, delete: if isTenantAdmin(resource.data.businessId);
    }

    // deliveryZoneRules: per-zone Jumia pricing. Admin-only — this is
    // the flat delivery fee a customer's total is computed from, never
    // a client-writable value.
    match /deliveryZoneRules/{ruleId} {
      allow read: if isTenantAdmin(resource.data.businessId);
      // seed script / Admin SDK only in practice
      allow create: if isTenantAdmin(request.resource.data.businessId);
      allow update, delete: if isTenantAdmin(resource.data.businessId);
    }

    // businesses: the tenant profile itself. The document ID *is* the
    // businessId, so this is the one collection scoped directly off
    // the path variable rather than a `businessId` field.
    match /businesses/{businessId} {
      allow read: if isTenantAdmin(businessId);
      allow write: if false; // provisioned via seed script / Admin SDK only

      // integrationSecrets: provider credentials (Daraja, Whatchimp,
      // Jumia, Meta) — the single most sensitive collection in the
      // schema. Unconditional deny, no admin exception, ever. Every
      // Gateway config module reads this via the Admin SDK, which
      // bypasses rules entirely — there is no legitimate client read.
      match /integrationSecrets/{provider} {
        allow read, write: if false;
      }

      // featureFlags: tenant-scoped runtime switches (§ Phase 6).
      // Not secret, so admin-readable — still server/Admin SDK-only to
      // write, same as every other business-config mutation in this
      // app (`FeatureFlagService`, via `app/api/admin/feature-flags`).
      // `businessId` here is the parent match's path variable, same
      // reasoning as `businesses/{businessId}` above.
      match /featureFlags/{key} {
        allow read: if isTenantAdmin(businessId);
        allow write: if false;
      }

      // creatorMemberships: creator business-relationship data, keyed
      // by Firebase Auth uid (§ Creator Marketplace migration) —
      // nested under the owning business so the same uid can hold an
      // independent membership in more than one business. Formerly a
      // flat top-level `creatorProfiles/{uid}` collection, which
      // structurally pinned one uid to exactly one business
      // platform-wide. `businessId` here is the parent match's path
      // variable, same reasoning as `featureFlags` above.
      match /creatorMemberships/{uid} {
        allow read: if isOwner(uid) || isTenantAdmin(businessId);
        allow create: if false; // server-created at sign-up (see §8 automation)
        allow update: if (isOwner(uid) &&
                            // creators may edit their own profile fields,
                            // but never the financial fields directly
                            !request.resource.data.diff(resource.data)
                              .affectedKeys()
                              .hasAny(['availableCashKes','pendingEarningsKes',
                                       'lifetimeEarningsKes','status',
                                       'commissionRateKes'])) || isTenantAdmin(businessId);
        allow delete: if false;

        // earningsLedger: the immutable source of truth behind
        // availableCashKes/lifetimeEarningsKes above — server-written
        // only, same discipline as customerWallets' ledger.
        match /earningsLedger/{entryId} {
          allow read: if isOwner(uid) || isTenantAdmin(businessId);
          allow write: if false;
        }
      }
    }
  }
}
