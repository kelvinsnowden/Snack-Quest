# Copy to .env.local for local development against the Firebase Emulator
# Suite (see IMPLEMENTATION_GUIDE.md Appendix B and TDD §17).

# Set to "true" to point both the client and Admin SDKs at the local
# emulators instead of a real Firebase project. No real credentials are
# required in this mode.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# Public — safe in the client bundle. For emulator-only development these
# can stay as placeholder values; the client SDK never leaves localhost.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-project.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# Private — server-only, read only inside Route Handlers / Server Actions /
# Cloud Functions / proxy.ts. Not required when
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true, since the Admin SDK auto-detects
# the emulators via FIRESTORE_EMULATOR_HOST / FIREBASE_AUTH_EMULATOR_HOST
# and does not need real service-account credentials in that mode.
FIREBASE_ADMIN_PROJECT_ID=demo-project
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Set to "true" once the Firebase project is upgraded to the Blaze plan
# and Cloud Storage is actually provisioned (TDD §16). Until then, leave
# unset/false — repositories/storageRepository.ts resolves to a stub
# that throws StorageUnavailableError instead of hitting a nonexistent
# bucket.
FIREBASE_STORAGE_ENABLED=false

# External services — not required for Phase 0 (offline emulator work).
# Populate when a task depends on them; each is a stop-and-ask credential
# dependency per the Phase 0 instructions.
#
# Daraja: register a sandbox app at https://developer.safaricom.co.ke to
# get a consumer key/secret; the sandbox shortcode/passkey are published
# on that portal (see PLATFORM_ARCHITECTURE_V2.md §18). DARAJA_CALLBACK_URL
# must be a publicly reachable HTTPS URL (Safaricom cannot call localhost) —
# an ngrok/similar tunnel during local development.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
# "sandbox" (default) or "production"
DARAJA_ENV=sandbox
SENDGRID_API_KEY=
# Whatchimp: WhatsApp Business Solution Provider. WHATCHIMP_WEBHOOK_VERIFY_TOKEN
# is a value you choose yourself and register with Whatchimp for the webhook
# verification handshake (see PLATFORM_ARCHITECTURE_V2.md §18, §21 Open Question 2).
WHATCHIMP_API_KEY=
WHATCHIMP_PHONE_NUMBER_ID=
WHATCHIMP_WEBHOOK_VERIFY_TOKEN=
# WHATCHIMP_BASE_URL=https://api.whatchimp.com/v1
