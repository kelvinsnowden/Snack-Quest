# Copy to .env.local for local development against the Firebase Emulator
# Suite (see IMPLEMENTATION_GUIDE.md Appendix B and TDD §17).

# Set to "true" to point both the client and Admin SDKs at the local
# emulators instead of a real Firebase project. No real credentials are
# required in this mode.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# Public — safe in the client bundle. For emulator-only development these
# can stay as placeholder values; the client SDK never leaves localhost.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-project.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# Private — server-only, read only inside Route Handlers / Server Actions /
# Cloud Functions / proxy.ts. Not required when
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true, since the Admin SDK auto-detects
# the emulators via FIRESTORE_EMULATOR_HOST / FIREBASE_AUTH_EMULATOR_HOST
# and does not need real service-account credentials in that mode.
FIREBASE_ADMIN_PROJECT_ID=demo-project
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Set to "true" once the Firebase project is upgraded to the Blaze plan
# and Cloud Storage is actually provisioned (TDD §16). Until then, leave
# unset/false — repositories/storageRepository.ts resolves to a stub
# that throws StorageUnavailableError instead of hitting a nonexistent
# bucket.
FIREBASE_STORAGE_ENABLED=false

# ---------------------------------------------------------------------------
# Multi-tenant platform (types/business.ts). None of the vars below are
# read by the running app anymore — every Gateway resolves its credentials
# per-business from `businesses/{businessId}/integrationSecrets/{provider}`
# in Firestore, never from process.env. These vars exist ONLY to seed
# Snack Quest — the platform's first tenant — the same way any future
# tenant's credentials would be entered (via future admin tooling, not env
# vars). Run `npm run seed:business` after setting these, then
# `npm run seed:packages`.
# ---------------------------------------------------------------------------

# Which businessId the seed scripts provision. Change only if you're
# deliberately seeding a second local tenant for testing.
SNACK_QUEST_BUSINESS_ID=snack-quest

# Daraja: register a sandbox app at https://developer.safaricom.co.ke to
# get a consumer key/secret; the sandbox shortcode/passkey are published
# on that portal (see PLATFORM_ARCHITECTURE_V2.md §18). DARAJA_CALLBACK_URL
# must be a publicly reachable HTTPS URL (Safaricom cannot call localhost) —
# an ngrok/similar tunnel during local development — and must match the
# per-tenant path: https://<host>/api/webhooks/daraja/<businessId>.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
# "sandbox" (default) or "production"
DARAJA_ENV=sandbox
SENDGRID_API_KEY=

# Whatchimp: WhatsApp Business Solution Provider.
WHATCHIMP_API_KEY=
WHATCHIMP_PHONE_NUMBER_ID=
# WHATCHIMP_BASE_URL=https://api.whatchimp.com/v1

# WHATCHIMP_WEBHOOK_VERIFY_TOKEN is the one exception that IS read at
# runtime (lib/integrations/whatchimp/config.ts) — it's platform-level,
# not tenant data: every business's inbound traffic hits the same shared
# webhook URL, verified once at the Meta App level, not per business. A
# value you choose yourself and register with Whatchimp for the webhook
# verification handshake (see PLATFORM_ARCHITECTURE_V2.md §18, §21 Open
# Question 2).
WHATCHIMP_WEBHOOK_VERIFY_TOKEN=

# Jumia Delivery: courier for both door delivery and pickup-station orders.
JUMIA_API_KEY=
JUMIA_MERCHANT_ID=
# JUMIA_BASE_URL=https://api.jumia.com/logistics/v1

# Meta Conversion API: ad attribution for orders started from a Meta ad.
META_PIXEL_ID=
META_ACCESS_TOKEN=
# META_API_VERSION=v21.0

# WhatsApp number (E.164, e.g. 254700000000) that gets a message for
# every new Snack Quest order. Leave unset to skip admin notifications.
# Stored on the business record itself (adminWhatsappPhone), not read
# at runtime from this env var — same seed-only pattern as the rest.
ADMIN_WHATSAPP_PHONE=
