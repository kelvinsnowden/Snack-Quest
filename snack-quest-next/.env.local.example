# Copy to .env.local for local development against the Firebase Emulator
# Suite (see IMPLEMENTATION_GUIDE.md Appendix B and TDD §17).

# The public origin the marketing site (app/(marketing)) is deployed at —
# used for metadataBase/canonical/OG URLs, app/sitemap.ts, and
# app/robots.ts (lib/seo/siteUrl.ts). No trailing slash. Falls back to
# http://localhost:3000 when unset, so local dev works without it.
NEXT_PUBLIC_SITE_URL=https://www.snackquests.shop

# Set to "true" to point both the client and Admin SDKs at the local
# emulators instead of a real Firebase project. No real credentials are
# required in this mode.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# Public — safe in the client bundle. For emulator-only development these
# can stay as placeholder values; the client SDK never leaves localhost.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-project
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# Private — server-only, read only inside Route Handlers / Server Actions /
# Cloud Functions / proxy.ts. Not required when
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true, since the Admin SDK auto-detects
# the emulators via FIRESTORE_EMULATOR_HOST / FIREBASE_AUTH_EMULATOR_HOST
# and does not need real service-account credentials in that mode.
FIREBASE_ADMIN_PROJECT_ID=demo-project
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# File storage: Vercel Blob (services/storageService.ts,
# lib/integrations/vercelBlob/). Firebase is Auth + Firestore only —
# Cloud Storage for Firebase required a Blaze billing upgrade this
# project intentionally avoids, so every upload (snack/box/marketing
# images, creator uploads, future documents) goes to Vercel Blob
# instead. Platform-wide, not per-business: one Vercel Blob store per
# deployment, unlike the per-tenant secrets below.
# ---------------------------------------------------------------------------

# Get this from the Vercel dashboard (Storage -> your Blob store ->
# .env.local tab), or run `vercel env pull` in a project linked to one.
# Required for real uploads; local dev without it will fail closed with
# a clear error rather than silently no-op.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Integration Portal (Admin > Settings > Integrations,
# lib/secrets/secretCipher.ts). Encrypts the secret-flagged fields of
# every integrationSecrets document at rest (AES-256-GCM). Optional —
# unset, values are stored as-is (today's behavior, fine for local/
# emulator dev); a production deployment should set this. Generate
# with `openssl rand -hex 32`. Rotating this key requires re-saving
# every integration's credentials through the portal (old ciphertext
# encrypted under the previous key won't decrypt) — there is no
# automatic re-encryption job.
SECRET_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Multi-tenant platform (types/business.ts). None of the vars below are
# read by the running app anymore — every Gateway resolves its credentials
# per-business from `businesses/{businessId}/integrationSecrets/{provider}`
# in Firestore, never from process.env. These vars exist ONLY to seed
# Snack Quest — the platform's first tenant — the same way any future
# tenant's credentials would be entered (via future admin tooling, not env
# vars). Run `npm run seed:business` after setting these, then
# `npm run seed:packages`.
# ---------------------------------------------------------------------------

# Which businessId the seed scripts provision. Change only if you're
# deliberately seeding a second local tenant for testing.
SNACK_QUEST_BUSINESS_ID=snack-quest

# Daraja: register a sandbox app at https://developer.safaricom.co.ke to
# get a consumer key/secret; the sandbox shortcode/passkey are published
# on that portal (see PLATFORM_ARCHITECTURE_V2.md §18). DARAJA_CALLBACK_URL
# must be a publicly reachable HTTPS URL (Safaricom cannot call localhost) —
# an ngrok/similar tunnel during local development — and must match the
# per-tenant path: https://<host>/api/webhooks/daraja/<businessId>.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
# "sandbox" (default) or "production"
DARAJA_ENV=sandbox

# ---------------------------------------------------------------------------
# Email + SMS (§ Notification breadth, lib/integrations/email/sendGridGateway.ts,
# lib/integrations/sms/africasTalkingGateway.ts). Platform-wide, not per-business
# — same "one credential per deployment" pattern as BLOB_READ_WRITE_TOKEN above,
# not a per-tenant Firestore secret like Daraja/Whatchimp/Jumia/Meta.
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=
# The verified SendGrid sender identity/domain this deployment sends from.
SENDGRID_FROM_EMAIL=

# Africa's Talking: Kenya-market SMS provider (chosen over Twilio — see
# lib/integrations/sms/africasTalkingGateway.ts's doc comment). Use the
# literal username "sandbox" during development to hit their sandbox API.
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=

# Authenticates Vercel Cron's call to app/api/cron/retry-notifications
# (§ NotificationService.retrySweep) — Vercel sends this as
# `Authorization: Bearer $CRON_SECRET`. Generate any long random string,
# e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Whatchimp: WhatsApp Business Solution Provider.
WHATCHIMP_API_KEY=
WHATCHIMP_PHONE_NUMBER_ID=
# WHATCHIMP_BASE_URL=https://api.whatchimp.com/v1
# The WhatsApp Product Catalog id products are synced to (services/productService.ts,
# lib/integrations/whatchimp/whatchimpGateway.ts syncItem/removeItem). Optional —
# a tenant without a catalog set up yet just gets a documented catalog-sync no-op.
WHATCHIMP_CATALOG_ID=

# Shared-secret auth for app/api/checkout/start and app/api/checkout/pay (§ Product
# Catalog & Checkout Architecture) — the routes Whatchimp calls the instant a
# customer selects a product, and again when they explicitly reply PAY. Same
# stopgap as INTERNAL_AGENT_API_KEY below: no real BSP request-signing exists to
# verify instead, since there is no real, documented Whatchimp API.
#
# Also covers the WhatChimp Bridge API (§ WhatChimp Integration Redesign,
# app/api/whatchimp/*, lib/webhooks/whatchimpBridgeAuth.ts) — the same
# WhatChimp bot flow calls these, so the same shared secret applies rather
# than provisioning a second one.
WHATCHIMP_CHECKOUT_API_KEY=

# Shared-secret auth for the human-agent door-delivery pricing route
# (app/api/internal/conversations/[conversationId]/price-door-delivery).
# Stopgap only, kept for that one internal route specifically — real staff
# sessions now exist (§ Admin auth foundation, services/staffAuthService.ts)
# and are what every /admin/* page and future agent-facing route uses instead.
INTERNAL_AGENT_API_KEY=

# ---------------------------------------------------------------------------
# Admin/staff auth (§ Admin auth foundation). Real Firebase Auth + Firestore
# staffProfiles — there is no self-registration into the Admin Portal, so the
# first super_admin account has to be provisioned by this seed script:
# `npm run seed:staff`. Every later staff account is created by an admin
# through the Admin Portal itself, not another seed script.
# ---------------------------------------------------------------------------
ADMIN_SEED_EMAIL=admin@snackquest.co
ADMIN_SEED_PASSWORD=change-me-before-real-use
ADMIN_SEED_NAME=Snack Quest Admin

# WHATCHIMP_WEBHOOK_VERIFY_TOKEN is the one exception that IS read at
# runtime (lib/integrations/whatchimp/config.ts) — it's platform-level,
# not tenant data: every business's inbound traffic hits the same shared
# webhook URL, verified once at the Meta App level, not per business. A
# value you choose yourself and register with Whatchimp for the webhook
# verification handshake (see PLATFORM_ARCHITECTURE_V2.md §18, §21 Open
# Question 2).
WHATCHIMP_WEBHOOK_VERIFY_TOKEN=

# WHATCHIMP_WEBHOOK_SECRET (§ Secure the Daraja and Whatchimp webhook
# routes, app/api/webhooks/whatchimp/route.ts) — real origin
# verification for every inbound Whatchimp request (GET handshake and
# POST message deliveries alike), checked against a `?key=` query
# param. Unlike Daraja's per-business webhookSecret, this one is NOT
# picked up automatically: after setting it, you must also update the
# webhook URL registered in Whatchimp's/Meta's app dashboard to include
# `?key=<this value>`, or Whatchimp will keep calling the bare URL and
# be rejected the moment this is set. Generate any long random string
# yourself, e.g. `openssl rand -hex 32`. Left unset, requests are
# accepted unverified (with a logged warning) rather than breaking
# real customer messaging — see lib/webhooks/webhookSecret.ts.
WHATCHIMP_WEBHOOK_SECRET=

# Jumia Delivery: courier for both door delivery and pickup-station orders.
JUMIA_API_KEY=
JUMIA_MERCHANT_ID=
# JUMIA_BASE_URL=https://api.jumia.com/logistics/v1

# Meta Conversion API: ad attribution for orders started from a Meta ad.
META_PIXEL_ID=
META_ACCESS_TOKEN=
# META_API_VERSION=v21.0

# WhatsApp number (E.164, e.g. 254700000000) that gets a message for
# every new Snack Quest order. Leave unset to skip admin notifications.
# Stored on the business record itself (adminWhatsappPhone), not read
# at runtime from this env var — same seed-only pattern as the rest.
ADMIN_WHATSAPP_PHONE=

# The real customer-facing WhatsApp number (E.164, e.g. 254700000000)
# behind WHATCHIMP_PHONE_NUMBER_ID above — distinct from it, since that's
# the Cloud API's internal identifier, not something a wa.me/ link can
# use. Powers creator referral-link click-throughs (app/r/[code]) and
# will power the marketing site's "Order on WhatsApp" CTAs. Same
# seed-only pattern as ADMIN_WHATSAPP_PHONE; also editable later from
# Admin > Settings.
WHATSAPP_CUSTOMER_NUMBER=

# Public website checkout tenant (server-only; do not expose customer/payment secrets)
PUBLIC_CHECKOUT_BUSINESS_ID=
