rules_version = '2';

// Placeholder deny-by-default ruleset for emulator bring-up.
// Refined alongside Firestore rules as portals that use Storage (creator
// content uploads, receipts) are migrated.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
